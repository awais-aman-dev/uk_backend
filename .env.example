# --- Core ---------------------------------------------------------------------------------------
# config.settings.local | config.settings.test | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.local
# [required in production] 50+ random characters.
SECRET_KEY=
# Local settings only; production is always False.
DEBUG=True
# Label for logs and error tracking: local | develop | staging | production
ENVIRONMENT=local

# --- Database -----------------------------------------------------------------------------------
# [required in production]
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uk_backend
# Seconds to keep connections open between requests (0 = close after each request).
DB_CONN_MAX_AGE=60

# --- Hosts & origins (comma-separated) ----------------------------------------------------------
# [required in production]
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=

# --- URLs ---------------------------------------------------------------------------------------
# [required in production] Storefront/cabinet frontend; a trailing slash is added if missing.
FRONTEND_BASE_URL=http://localhost:3000/
# Path the Django admin is served on.
ADMIN_URL=api/admin/

# --- HTTPS (production settings only) -----------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
